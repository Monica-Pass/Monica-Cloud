{
  "name": "monica-cloud-webui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && node scripts/icons.ts --check && vite build && node scripts/compress.ts",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "icons": "node scripts/icons.ts",
    "e2e": "node scripts/e2e.ts",
    "vectors": "node scripts/vectors.ts"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@m3e/web": "^2.5.8",
    "@vitejs/plugin-vue": "^6.0.7",
    "lit": "^3.3.3",
    "material-symbols": "^0.48.3",
    "tslib": "^2.8.1",
    "vite": "^8.0.16",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "fontkit": "2.0.4",
    "typescript": "^5.6.3",
    "vue-tsc": "^3.3.14",
    "wawoff2": "2.0.1"
  }
}
